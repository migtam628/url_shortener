# ============================================================================
# MT Link — environment configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# info | debug | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=mtlink
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mtlink
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full connection string used by Prisma and the redirect service's pg pool.
DATABASE_URL=postgresql://mtlink:change-me-in-production@postgres:5432/mtlink?schema=public

# Connection pool sizes. The redirect service only touches PG on a cache miss,
# so it needs far fewer connections than the API.
PG_POOL_MAX_API=20
PG_POOL_MAX_REDIRECT=10

# ---------------------------------------------------------------------------
# Redis — hot slug cache, pub/sub invalidation, and the BullMQ click queue
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
# TTL (seconds) for a cached link resolution in Redis.
REDIS_LINK_TTL=300
# Entries held in each redirect process's in-memory LRU.
LRU_MAX=1000
# TTL (ms) for an LRU entry. Keep this short: it is the worst-case staleness
# window if a Redis pub/sub invalidation message is ever missed.
LRU_TTL_MS=60000

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
API_PORT=4000
REDIRECT_PORT=4001
DASHBOARD_PORT=5173

# Public origin of the dashboard/API. Used for CORS and cookie domain.
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-openssl-rand-base64-48
SESSION_TTL_HOURS=720
# Set true when serving over HTTPS (production). Cookies get the Secure flag.
COOKIE_SECURE=false
# Cookie domain. Leave blank for host-only cookies (correct for localhost).
COOKIE_DOMAIN=

# Salt mixed into the daily rotating IP hash. Changing this makes historical
# ipHash values non-comparable — that is intentional and safe.
IP_HASH_SECRET=replace-me-with-openssl-rand-base64-32

# Open registration. Set false once your own account exists so the instance
# is not publicly signup-able.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REDIRECT_PER_MINUTE=0

# ---------------------------------------------------------------------------
# Link defaults
# ---------------------------------------------------------------------------
DEFAULT_SLUG_LENGTH=7
# Comma-separated hostnames this instance serves short links on. The SSRF /
# loop guard rejects destinations pointing back at any of these.
SHORT_DOMAINS=localhost,go.localhost,mt.lc
# Fallback when a request arrives for a domain root with no mainPageRedirect.
DEFAULT_ROOT_REDIRECT=

# ---------------------------------------------------------------------------
# GeoIP (MaxMind GeoLite2 City)
# ---------------------------------------------------------------------------
# Sign up free at maxmind.com for a licence key, then run scripts/update-geoip.sh.
# If the database file is absent the worker still runs; geo columns stay null.
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb

# ---------------------------------------------------------------------------
# Click pipeline
# ---------------------------------------------------------------------------
CLICK_QUEUE_NAME=clicks
CLICK_WORKER_CONCURRENCY=8
# Rows buffered before a batch insert, and max ms to hold a partial batch.
CLICK_BATCH_SIZE=200
CLICK_BATCH_MS=1000

# ---------------------------------------------------------------------------
# Open Graph preview fetching
# ---------------------------------------------------------------------------
OG_FETCH_TIMEOUT_MS=5000
OG_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
# Leave blank for no auth on /metrics (fine when it is not publicly routed).
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Trust proxy — number of reverse proxies in front of the services.
# Behind Cloudflare -> NGINX this is 2. Direct NGINX only, 1. None, 0.
# Getting this wrong means rate limits and geo see the wrong client IP.
# ---------------------------------------------------------------------------
TRUST_PROXY_HOPS=1
