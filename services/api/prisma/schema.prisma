// MT Link data model.
//
// Note on `click`: it is a RANGE-partitioned table on `ts`. Prisma Migrate
// cannot express partitioning, so the real DDL lives in the hand-written
// migration under prisma/migrations/. This block exists so Prisma Client
// generates correct types for it. Keep the two in sync by hand — there is a
// test (tests/schema.test.ts) that compares the column sets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  member
  viewer
}

enum CertStatus {
  pending
  issuing
  active
  failed
}

enum RuleMatchType {
  country
  region
  device
  os
  language
  referrer
  ab
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("self-hosted")
  createdAt DateTime @default(now()) @map("created_at")

  users    User[]
  apiKeys  ApiKey[]
  domains  Domain[]
  folders  Folder[]
  sessions Session[]

  @@map("tenant")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(member)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  createdLinks  Link[]        @relation("LinkCreatedBy")
  linkVersions  LinkVersion[]

  @@index([tenantId])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ipHash    String?  @map("ip_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  prefix     String    @unique
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_key")
}

model Domain {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  hostname         String     @unique
  isDefault        Boolean    @default(false) @map("is_default")
  mainPageRedirect String?    @map("main_page_redirect")
  notFoundRedirect String?    @map("not_found_redirect")
  certStatus       CertStatus @default(pending) @map("cert_status")
  certLastError    String?    @map("cert_last_error")
  certRenewAt      DateTime?  @map("cert_renew_at")
  verifiedAt       DateTime?  @map("verified_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  Link[]

  @@index([tenantId])
  @@map("domain")
}

model Folder {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  links    Link[]

  @@unique([tenantId, parentId, name])
  @@index([tenantId])
  @@map("folder")
}

model Link {
  id           String    @id @default(uuid()) @db.Uuid
  domainId     String    @map("domain_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  slug         String
  destination  String
  redirectCode Int       @default(302) @map("redirect_code")
  title        String?
  description  String?
  folderId     String?   @map("folder_id") @db.Uuid
  tags         String[]  @default([])
  createdById  String?   @map("created_by_id") @db.Uuid
  ogTitle      String?   @map("og_title")
  ogDescription String?  @map("og_description")
  ogImage      String?   @map("og_image")
  ogFetchedAt  DateTime? @map("og_fetched_at")
  clickCount   BigInt    @default(0) @map("click_count")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  domain    Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  folder    Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("LinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions  LinkVersion[]
  rules     LinkRule[]
  security  LinkSecurity?

  @@unique([domainId, slug])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, folderId])
  @@index([tags], type: Gin)
  @@map("link")
}

model LinkVersion {
  id           String   @id @default(uuid()) @db.Uuid
  linkId       String   @map("link_id") @db.Uuid
  destination  String
  redirectCode Int      @map("redirect_code")
  slug         String
  changedById  String?  @map("changed_by_id") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at")
  note         String?

  link      Link  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([linkId, changedAt(sort: Desc)])
  @@map("link_version")
}

model LinkRule {
  id          String        @id @default(uuid()) @db.Uuid
  linkId      String        @map("link_id") @db.Uuid
  priority    Int           @default(0)
  matchType   RuleMatchType @map("match_type")
  matchValue  Json          @map("match_value")
  destination String
  weight      Int           @default(100)
  createdAt   DateTime      @default(now()) @map("created_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, priority])
  @@map("link_rule")
}

model LinkSecurity {
  linkId          String    @id @map("link_id") @db.Uuid
  passwordHash    String?   @map("password_hash")
  expiresAt       DateTime? @map("expires_at")
  expiredRedirect String?   @map("expired_redirect")
  maxClicks       Int?      @map("max_clicks")
  clickCount      Int       @default(0) @map("click_count")
  cloak           Boolean   @default(false)
  hideReferrer    Boolean   @default(false) @map("hide_referrer")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("link_security")
}

/// Partitioned by RANGE (ts). The primary key must include the partition key,
/// hence the composite id. See the init migration for the real DDL.
model Click {
  id           BigInt   @default(autoincrement())
  ts           DateTime @default(now()) @db.Timestamptz(3)
  linkId       String   @map("link_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ipHash       String?  @map("ip_hash")
  country      String?  @db.Char(2)
  region       String?
  city         String?
  deviceType   String?  @map("device_type")
  os           String?
  browser      String?
  language     String?  @db.VarChar(16)
  referrerHost String?  @map("referrer_host")
  ruleId       String?  @map("rule_id") @db.Uuid
  isBot        Boolean  @default(false) @map("is_bot")

  @@id([id, ts])
  @@index([linkId, ts(sort: Desc)])
  @@index([tenantId, ts(sort: Desc)])
  @@map("click")
}

/// Daily pre-aggregate. Ranges longer than 30 days are served from here so a
/// year-long analytics query never scans the raw click table.
model ClickDaily {
  day        DateTime @db.Date
  linkId     String   @map("link_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Never null: a Postgres primary key cannot contain a nullable column, so
  /// unknown geo/device is stored as the sentinel "--" / "unknown".
  country    String   @default("--") @db.Char(2)
  deviceType String   @default("unknown") @map("device_type")
  clicks     BigInt   @default(0)
  bots       BigInt   @default(0)

  @@id([day, linkId, country, deviceType])
  @@index([tenantId, day])
  @@map("click_daily")
}

/// Key/value store for worker bookkeeping (rollup watermark, partition state).
model SystemState {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_state")
}
