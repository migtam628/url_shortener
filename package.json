{
  "name": "mt-link",
  "version": "0.1.0",
  "private": true,
  "description": "MT Link \u2014 self-hosted branded link shortener and redirect platform",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n api,redirect,worker,ui -c cyan,magenta,yellow,green \"npm -w @mtlink/api run dev\" \"npm -w @mtlink/redirect run dev\" \"npm -w @mtlink/api run dev:worker\" \"npm -w @mtlink/dashboard run dev\"",
    "migrate": "npm -w @mtlink/api run migrate",
    "seed": "npm -w @mtlink/api run seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.3"
  }
}
